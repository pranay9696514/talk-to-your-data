import streamlit as st
import pandas as pd
import sqlite3

st.sidebar.header("📁 Your Data")
uploaded = st.sidebar.file_uploader("Upload a CSV", type=["csv"])

@st.cache_resource
def build_db_from_csv(file):
    df = pd.read_csv(file)
    conn = sqlite3.connect(":memory:", check_same_thread=False)
    df.to_sql("data", conn, if_exists="replace", index=False)
    return conn

if uploaded:
    conn = build_db_from_csv(uploaded)
    st.sidebar.success(f"Loaded! Table name: **data**")
else:
    conn = sqlite3.connect("shop.db", check_same_thread=False)  # fallback to demo
    st.sidebar.info("Using demo database (shop.db)")
